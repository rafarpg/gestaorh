<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".PontoApp"
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_recent_history"
        android:label="@string/app_name"
        android:theme="@style/Theme.Ponto"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.inicio.InicioActivity" />
        <activity android:name=".ui.historico.HistoricoActivity" android:label="@string/historico" />
        <activity android:name=".ui.ferias.FeriasActivity" />
        <activity android:name=".ui.funcionarios.FuncionariosActivity" android:label="@string/funcionarios" />
    </application>

</manifest>
